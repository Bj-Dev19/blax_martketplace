# ====================================================================
# Render & Aiven MySQL Production Environment Variables
# ====================================================================
# Configure these variables in the Render Dashboard under your web service:
# Environment -> Add Environment Variable (or via render.yaml sync: false)
# ====================================================================

# Environment mode: MUST be production on live servers (never `development` on a server - disables debug toolbar, display_errors, and DB debug)
CI_ENVIRONMENT = production

# Full canonical URL of your deployed Render service (e.g. https://blax-marketplace.onrender.com/)
# Can be found at the top of your Render Web Service dashboard.
APP_BASE_URL = https://blax-marketplace.onrender.com/

# --------------------------------------------------------------------
# Aiven MySQL Database Connection
# --------------------------------------------------------------------
# Retrieve these values from your Aiven Console:
# Project -> Services -> Your MySQL Service -> "Overview" tab -> "Connection information"
# NOTE: The default Aiven database name is blax_inventory (created upon manual import).
# NOTE: The Aiven port is a dynamic high port (e.g. 10000-28000), NOT 3306.
DB_HOST = your-mysql-service.aivencloud.com
DB_PORT = 12345
DB_USER = avnadmin
DB_PASSWORD = your_aiven_password_here
DB_DATABASE = blax_inventory

# TLS to Aiven. CodeIgniter only enables MySQL encryption when a CA bundle is
# supplied, so this is not optional in production: without it the connection to
# a public-internet host is plaintext. Download the service CA from the Aiven
# console (Services -> your service -> Connection info) and commit it to
# docker/certs/aiven-ca.pem; the path below is inside the built image.
DB_SSL_CA = /var/www/html/docker/certs/aiven-ca.pem
# Verify the server certificate against that CA. Set to false only to
# troubleshoot a CA mismatch; that downgrades to encryption-without-auth.
DB_SSL_VERIFY = true

# --------------------------------------------------------------------
# Cloudinary Media Storage (Product images, logos, receipts)
# --------------------------------------------------------------------
# Retrieve from: Cloudinary Console (https://console.cloudinary.com/pm) -> Dashboard / API Keys
CLOUDINARY_CLOUD_NAME = your_cloudinary_cloud_name
CLOUDINARY_API_KEY = your_cloudinary_api_key
CLOUDINARY_API_SECRET = your_cloudinary_api_secret

# --------------------------------------------------------------------
# PayMongo Payment Gateway (E-wallets, cards, disbursements)
# --------------------------------------------------------------------
# Retrieve from: PayMongo Dashboard (https://dashboard.paymongo.com/) -> Developers -> API Keys & Webhooks
PAYMONGO_PUBLIC_KEY = pk_live_your_public_key_here
PAYMONGO_SECRET_KEY = sk_live_your_secret_key_here
PAYMONGO_WEBHOOK_SECRET = whsec_your_webhook_signing_secret_here
# Boot policy when the webhook secret above is missing or still a placeholder.
# false (default): the container boots and serves; webhooks fail closed (HTTP 400)
#   and paid orders wait for manual confirmation until the real secret is set.
# true: the container refuses to boot - use only where accepting payments is
#   mandatory and a silent payment outage would be worse than a downtime.
REQUIRE_PAYMONGO_WEBHOOK = false

# --------------------------------------------------------------------
# Brevo (Sendinblue) Email HTTP API
# --------------------------------------------------------------------
# Render Free blocks outbound SMTP ports 25, 465, and 587. Email MUST use Brevo HTTP API (Port 443).
# Retrieve from: Brevo Dashboard (https://app.brevo.com/) -> SMTP & API -> API Keys
BREVO_API_KEY = xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL = verified_sender@yourdomain.com
BREVO_SENDER_NAME = "Blax General Merchandise"

# --------------------------------------------------------------------
# Google Maps Platform (Directions, Geocoding, Places)
# --------------------------------------------------------------------
# Retrieve from: Google Cloud Console -> APIs & Services -> Credentials
# Ensure HTTP referrers allow your Render domain (e.g. https://blax-marketplace.onrender.com/*)
GOOGLE_MAPS_API_KEY = your_google_maps_api_key_here

# --------------------------------------------------------------------
# Cohere AI (Semantic Product & Catalog Search)
# --------------------------------------------------------------------
# Retrieve from: Cohere Dashboard (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY = your_cohere_api_key_here

# --------------------------------------------------------------------
# TextBee SMS Gateway (Order & dispatch SMS alerts)
# --------------------------------------------------------------------
# Retrieve from: TextBee Dashboard (https://textbee.dev/dashboard)
TEXTBEE_API_KEY = your_textbee_api_key_here
TEXTBEE_DEVICE_ID = your_textbee_device_id_here
TEXTBEE_BASE_URL = "https://api.textbee.dev/api/v1"

# --------------------------------------------------------------------
# Performance & Boot Optimization
# --------------------------------------------------------------------
# Set to 'false' after your initial deployment to eliminate 5-15s migration checks on container wake-ups
RUN_MIGRATIONS = true

